{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "registry/**",
      "assets/**",
      "*.json",
      "*.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!**/gen",
      "!**/icons",
      "!bun.lock"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
