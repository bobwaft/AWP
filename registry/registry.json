{
  "version": 1,
  "items": [
    {
      "id": "graphify",
      "kind": "skill",
      "name": "Graphify",
      "summary": "Local tree-sitter knowledge graph of the code; query, path and explain commands so the agent reads less.",
      "source": {
        "repo": "https://github.com/Graphify-Labs/graphify",
        "sha": "10130e79ed9caf8f60d998073e097531eaa1a395"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["codebase", "graph", "tokens"],
      "default": true,
      "install": {
        "type": "installer",
        "commands": [
          ["uv", "tool", "install", "graphifyy"],
          ["graphify", "install", "--project"]
        ]
      },
      "group": "G1",
      "groupMode": "pick-one",
      "flags": {
        "notes": [
          "Needs Python 3.10+ and uv. The code graph needs no LLM; the docs and media pass uses the model."
        ]
      }
    },
    {
      "id": "understand-anything",
      "kind": "plugin",
      "name": "Understand Anything",
      "summary": "Multi-agent knowledge graph of the codebase with a browser dashboard.",
      "source": {
        "repo": "https://github.com/Egonex-AI/Understand-Anything",
        "sha": "f2d0164f72fe678805c34245a6df36acededfebd"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["codebase", "dashboard", "visual graph"],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "Egonex-AI/Understand-Anything",
        "plugin": "understand-anything@understand-anything"
      },
      "group": "G1",
      "groupMode": "pick-one",
      "flags": {
        "notes": [
          "The first /understand run is token-heavy on large repos.",
          "Node 18+ for the dashboard."
        ]
      }
    },
    {
      "id": "context7",
      "kind": "mcp",
      "name": "Context7",
      "summary": "Version-specific library and API docs on demand.",
      "source": {
        "repo": "https://github.com/upstash/context7",
        "sha": "1658cc4213e2700d29acff9bc11cdefbdd1eeaa1"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["library", "api", "docs", "framework"],
      "default": true,
      "install": {
        "type": "mcp",
        "entry": {
          "type": "http",
          "url": "https://mcp.context7.com/mcp"
        }
      },
      "group": "G2",
      "groupMode": "pick-one",
      "variants": [
        {
          "id": "api-key",
          "label": "Use my free API key (higher rate limits)",
          "safe": false,
          "install": {
            "type": "mcp",
            "entry": {
              "type": "http",
              "url": "https://mcp.context7.com/mcp",
              "headers": {
                "Authorization": "Bearer ${CONTEXT7_API_KEY}"
              }
            }
          }
        }
      ],
      "requires": {
        "env": [
          {
            "name": "CONTEXT7_API_KEY",
            "secretKey": "awp/context7/default",
            "optional": true,
            "help": "Optional. A free key at context7.com/dashboard raises the rate limits."
          }
        ]
      }
    },
    {
      "id": "ponytail",
      "kind": "plugin",
      "name": "Ponytail",
      "summary": "Lazy-senior-dev mode: the smallest change that solves the task, plus review, audit and debt commands.",
      "source": {
        "repo": "https://github.com/DietrichGebert/ponytail",
        "sha": "84740e3d344b69b4a133201fa519eb37a62a2b2a"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["tokens", "code size", "minimal"],
      "default": true,
      "install": {
        "type": "plugin",
        "marketplace": "DietrichGebert/ponytail",
        "plugin": "ponytail@ponytail"
      },
      "group": "G3",
      "groupMode": "complementary",
      "flags": {
        "notes": ["Savings figures are self-reported by the project."]
      }
    },
    {
      "id": "caveman",
      "kind": "tool",
      "name": "Caveman",
      "summary": "Terse agent replies and trimmed tool output to save tokens. Build phases only.",
      "source": {
        "repo": "https://github.com/JuliusBrussee/caveman",
        "sha": "d262ab3882952a59312ff3537cd86d894523c5ab"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["tokens", "terse"],
      "default": false,
      "install": {
        "type": "doc",
        "command": "npx @caveman-ai/cli@latest"
      },
      "group": "G3",
      "groupMode": "complementary",
      "neverStages": ["ideation", "design", "planning"],
      "flags": {
        "telemetry": true,
        "notes": [
          "Run it yourself: it edits your global ~/.claude/settings.json (hooks and statusline), and its non-interactive mode is unverified.",
          "Needs Node 22.13+. Keep the cloud features off.",
          "AWP never enables it for interview or spec stages."
        ]
      }
    },
    {
      "id": "impeccable",
      "kind": "skill",
      "name": "Impeccable",
      "summary": "Design skills and detectors: design, critique, polish and harden UI.",
      "source": {
        "repo": "https://github.com/pbakaus/impeccable",
        "sha": "5bf0a069dc857e1b5f4b090e004d9d5b231416ca"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design", "implementation", "polishing"],
      "tags": ["ui", "design", "frontend", "web"],
      "default": true,
      "install": {
        "type": "installer",
        "commands": [
          [
            "npx",
            "impeccable",
            "install",
            "--providers=claude",
            "--scope=project"
          ]
        ]
      },
      "group": "G5",
      "groupMode": "pick-one",
      "flags": {
        "telemetry": true,
        "notes": [
          "Telemetry is on by default; opt out with `npx impeccable telemetry off`.",
          "Calls the impeccable.style API at design start and installs a UI-edit hook into .claude/settings.local.json."
        ]
      }
    },
    {
      "id": "taste-skill",
      "kind": "plugin",
      "name": "Taste Skill",
      "summary": "Art direction and a browser self-check for distinctive marketing and landing sites.",
      "source": {
        "repo": "https://github.com/Leonxlnx/taste-skill",
        "sha": "f624f37a8c650b9cc550253104925efe4c8de246"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design", "implementation"],
      "tags": ["landing page", "marketing site", "website"],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "Leonxlnx/taste-skill",
        "plugin": "taste-skill@taste-skill"
      },
      "group": "G5",
      "groupMode": "pick-one",
      "flags": {
        "notes": [
          "Needs Node 22+ and a Chromium browser; uses network image search."
        ]
      }
    },
    {
      "id": "ui-ux-pro-max",
      "kind": "plugin",
      "name": "UI/UX Pro Max",
      "summary": "Generates design systems (styles, palettes, type, patterns) for web and mobile.",
      "source": {
        "repo": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill",
        "sha": "56ea9cf174ed86786187daa9de0e6247cb0747e4"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design", "implementation"],
      "tags": ["mobile app", "design system", "ios", "android"],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "nextlevelbuilder/ui-ux-pro-max-skill",
        "plugin": "ui-ux-pro-max@ui-ux-pro-max-skill"
      },
      "group": "G5",
      "groupMode": "pick-one",
      "flags": {
        "notes": ["Needs Python 3 (stdlib only)."]
      }
    },
    {
      "id": "frontend-design",
      "kind": "plugin",
      "name": "Frontend Design",
      "summary": "Anthropic's skill for distinctive frontend UI; the lightest-weight design option.",
      "source": {
        "repo": "https://github.com/anthropics/claude-plugins-official",
        "sha": "ea10b213686c90bb1984b2016937310e05336cf3"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design", "implementation"],
      "tags": ["ui", "frontend"],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "anthropics/claude-plugins-official",
        "plugin": "frontend-design@claude-plugins-official"
      },
      "group": "G5",
      "groupMode": "pick-one"
    },
    {
      "id": "react-bits",
      "kind": "library",
      "name": "React Bits",
      "summary": "215+ animated React components and backgrounds, copied into your project.",
      "source": {
        "repo": "https://github.com/DavidHDev/react-bits",
        "sha": "963f4d21dca65326a470956c42b7b467804f3c14"
      },
      "license": "MIT + Commons Clause",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["react", "animated components", "animation ui"],
      "default": false,
      "install": {
        "type": "doc",
        "command": "npx shadcn@latest add @react-bits/<Component>"
      },
      "group": "G6",
      "groupMode": "complementary",
      "flags": {
        "notes": [
          "You may use it in any app, including commercial ones; selling the components themselves is not allowed.",
          "Some files carry third-party notices to keep."
        ]
      }
    },
    {
      "id": "gsap-skills",
      "kind": "plugin",
      "name": "GSAP Skills",
      "summary": "Correct GSAP usage: timelines, ScrollTrigger, plugins and performance.",
      "source": {
        "repo": "https://github.com/greensock/gsap-skills",
        "sha": "aed9cfd3277740755f6bfc1155c7aa645403b760"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design", "implementation"],
      "tags": ["animation", "scroll", "gsap", "motion"],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "greensock/gsap-skills",
        "plugin": "gsap-skills@gsap-skills"
      },
      "group": "G7",
      "groupMode": "complementary",
      "guards": [
        {
          "when": [
            "visual animation builder",
            "no-code animation",
            "animation tool for non-coders",
            "no-code visual animation"
          ],
          "action": "skip",
          "note": "GSAP's license bars tools that let users build visual animations without code. Use anime.js instead."
        }
      ],
      "flags": {
        "notes": [
          "GSAP itself is free under the Standard No Charge license, including commercial use; it prohibits use in no-code visual animation builders that compete with Webflow.",
          "The non-binding summary adds \"as long as end users are not charged a fee\"."
        ]
      }
    },
    {
      "id": "lenis",
      "kind": "library",
      "name": "Lenis",
      "summary": "Smooth scrolling over native scroll; pairs with GSAP ScrollTrigger.",
      "source": {
        "repo": "https://github.com/darkroomengineering/lenis",
        "sha": "e01eefb1f55cd08bc051521d74f5f8182b71ee9d"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["smooth scroll", "scroll"],
      "default": false,
      "install": {
        "type": "doc",
        "command": "npm i lenis"
      },
      "group": "G7",
      "groupMode": "complementary"
    },
    {
      "id": "animejs",
      "kind": "library",
      "name": "Anime.js",
      "summary": "Lightweight JavaScript animation library (v4); used instead of GSAP when the GSAP guard trips.",
      "source": {
        "repo": "https://github.com/juliangarnier/anime",
        "sha": "01b81be1df6843ccfe0a71c0699a746bf740dd77"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["animation", "motion", "visual animation builder"],
      "default": false,
      "install": {
        "type": "doc",
        "command": "npm i animejs"
      },
      "group": "G7",
      "groupMode": "complementary",
      "flags": {
        "notes": [
          "License from package.json; the repo has no root LICENSE file."
        ]
      }
    },
    {
      "id": "playwright-mcp",
      "kind": "mcp",
      "name": "Playwright MCP",
      "summary": "Browser automation through accessibility snapshots, so the agent can check its own UI.",
      "source": {
        "repo": "https://github.com/microsoft/playwright-mcp",
        "sha": "b8b4183e099f136cbec0388a6088d4aa2f6b9685"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation", "testing"],
      "tags": ["web app", "website", "browser", "e2e"],
      "default": true,
      "install": {
        "type": "mcp",
        "entry": {
          "command": "npx",
          "args": ["@playwright/mcp@latest"]
        }
      },
      "defaultWhen": [
        "web app",
        "website",
        "web",
        "browser",
        "frontend",
        "react",
        "vue",
        "svelte",
        "next.js",
        "vite"
      ],
      "group": "G8",
      "groupMode": "pick-one"
    },
    {
      "id": "chrome-devtools-mcp",
      "kind": "mcp",
      "name": "Chrome DevTools MCP",
      "summary": "Console, network, performance traces and DOM inspection.",
      "source": {
        "repo": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
        "sha": "6606011ab3cdbc018904554dceae6ad6c5477fde"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation", "testing"],
      "tags": ["performance", "debugging", "web app", "browser"],
      "default": false,
      "install": {
        "type": "mcp",
        "entry": {
          "command": "npx",
          "args": ["-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
        }
      },
      "group": "G8",
      "groupMode": "pick-one",
      "flags": {
        "notes": [
          "Needs Chrome. Usage statistics are switched off in the entry."
        ]
      }
    },
    {
      "id": "security-guidance",
      "kind": "plugin",
      "name": "Security Guidance",
      "summary": "Hook-based security checks on Claude's edits (Anthropic official).",
      "source": {
        "repo": "https://github.com/anthropics/claude-plugins-official",
        "sha": "ea10b213686c90bb1984b2016937310e05336cf3"
      },
      "license": "Apache-2.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation", "security"],
      "tags": ["security"],
      "default": true,
      "install": {
        "type": "plugin",
        "marketplace": "anthropics/claude-plugins-official",
        "plugin": "security-guidance@claude-plugins-official"
      },
      "group": "G9",
      "groupMode": "complementary"
    },
    {
      "id": "trailofbits-skills",
      "kind": "plugin",
      "name": "Trail of Bits Skills",
      "summary": "Code audit, static analysis, Semgrep rule authoring and supply-chain review (installs static-analysis).",
      "source": {
        "repo": "https://github.com/trailofbits/skills",
        "sha": "5c99c03fb8a9ea568432ecbcba5d86e9f4ac2bf0"
      },
      "license": "CC-BY-SA-4.0",
      "verified": true,
      "agents": ["claude"],
      "stages": ["security"],
      "tags": [
        "auth",
        "payments",
        "user data",
        "personal data",
        "authentication"
      ],
      "default": false,
      "install": {
        "type": "plugin",
        "marketplace": "trailofbits/skills",
        "plugin": "static-analysis@trailofbits"
      },
      "group": "G9",
      "groupMode": "complementary",
      "flags": {
        "notes": [
          "Share-alike license: AWP links and installs it, and never bundles or modifies it.",
          "The marketplace has ~50 plugins; more can be installed later from your own Claude Code."
        ]
      }
    },
    {
      "id": "figma",
      "kind": "connector",
      "name": "Figma",
      "summary": "Design context, Code Connect and canvas write through Figma's hosted MCP.",
      "source": {},
      "license": "Figma Developer Terms (hosted)",
      "verified": true,
      "agents": ["claude"],
      "stages": ["design"],
      "tags": ["figma"],
      "default": false,
      "install": {
        "type": "mcp",
        "entry": {
          "type": "http",
          "url": "https://mcp.figma.com/mcp"
        }
      },
      "group": "G10",
      "groupMode": "complementary",
      "requires": {
        "accounts": ["figma"]
      },
      "flags": {
        "writes": true,
        "cost": "Call limits by seat: View/Collab ~20 calls/month, Professional Full/Dev 200/day, Enterprise 600/day; Starter is effectively unusable.",
        "notes": [
          "Authenticates with OAuth: run /mcp in Claude Code after install.",
          "Canvas write needs a Full seat."
        ]
      }
    },
    {
      "id": "github-mcp",
      "kind": "mcp",
      "name": "GitHub MCP",
      "summary": "Repos, issues, pull requests and Actions for the agent.",
      "source": {
        "repo": "https://github.com/github/github-mcp-server",
        "sha": "e3809fe91c7546633241006bf0b91f23b2595e28"
      },
      "license": "MIT",
      "verified": true,
      "agents": ["claude"],
      "stages": ["implementation"],
      "tags": ["github", "issues", "pull request", "github actions"],
      "default": false,
      "install": {
        "type": "mcp",
        "entry": {
          "type": "http",
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": {
            "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
          }
        }
      },
      "group": "G10",
      "groupMode": "complementary",
      "requires": {
        "env": [
          {
            "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
            "secretKey": "awp/github/default",
            "optional": false,
            "help": "A GitHub personal access token with the scopes you want the agent to have."
          }
        ]
      },
      "flags": {
        "writes": true
      }
    },
    {
      "id": "supabase",
      "kind": "connector",
      "name": "Supabase",
      "summary": "Projects, database, migrations and edge functions.",
      "source": {
        "repo": "https://github.com/supabase/mcp",
        "sha": "f46b3d2996d93baad25cce1b94b46440dcc44ecb"
