{
  "id": "design_schema",
  "title": "Design tokens",
  "fields": [
    {
      "id": "color_bg",
      "label": "Background",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_surface",
      "label": "Surface (cards, inputs)",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_text",
      "label": "Text",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_text_muted",
      "label": "Muted text",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_accent",
      "label": "Accent",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_on_accent",
      "label": "Text on accent",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_line",
      "label": "Borders",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_success",
      "label": "Success",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_warning",
      "label": "Warning",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "color_danger",
      "label": "Danger",
      "type": "color",
      "required": true,
      "fills": "design.color"
    },
    {
      "id": "font_sans",
      "label": "Interface font",
      "type": "font",
      "required": true,
      "fills": "design.typography"
    },
    {
      "id": "font_mono",
      "label": "Code font",
      "type": "font",
      "required": true,
      "fills": "design.typography"
    },
    {
      "id": "density",
      "label": "Density",
      "type": "select",
      "required": true,
      "fills": "design.spacing_radius",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "comfortable", "label": "Comfortable" },
        { "value": "spacious", "label": "Spacious" }
      ]
    },
    {
      "id": "radius",
      "label": "Corner radius (px)",
      "type": "number",
      "min": 0,
      "max": 32,
      "required": true,
      "fills": "design.spacing_radius"
    },
    {
      "id": "motion",
      "label": "Motion",
      "type": "select",
      "required": true,
      "fills": "design.motion",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "expressive", "label": "Expressive" }
      ]
    },
    {
      "id": "references",
      "label": "More references (URLs)",
      "type": "list",
      "fills": "design.references",
      "fields": [{ "id": "url", "label": "URL", "type": "url" }]
    }
  ]
}
